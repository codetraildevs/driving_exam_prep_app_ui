DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=traffic_rules_db
DB_USER=root
DB_PASS=
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=*

# Comma-separated SHA-256 fingerprints from Play Console > App integrity.
# Use the APP SIGNING certificate, not just the upload certificate.
ANDROID_APP_SIGNING_SHA256=

# Optional: timezone historically used by PHP when writing users.createdAt.
# Defaults to PHP's current date.timezone. Set only after verifying stored times.
# USER_REGISTRATION_TIMEZONE=UTC

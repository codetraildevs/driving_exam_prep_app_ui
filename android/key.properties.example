# Release Signing Configuration (template)
#
# Copy this file to android/key.properties and fill in the real values.
# android/key.properties is git-ignored — NEVER commit the real file or the keystore.
#
# storeFile is resolved relative to android/app/ (see android/app/build.gradle.kts).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=your-key-alias
storeFile=your-release-key.jks
